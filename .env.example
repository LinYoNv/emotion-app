# 情绪app 配置模板 —— 复制为 .env 后填写
#   cp .env.example .env && chmod 600 .env
# ⚠️ .env 含密钥，已被 .gitignore 挡住，**绝不要提交**

# ---- 服务 ----
# 🔴 `0.0.0.0` = 对整个网络开放（唯一屏障是令牌）；只自用建议保持 127.0.0.1
EMOTION_SERVER_HOST=127.0.0.1
# 🔴 别改回 6190 —— 那是陪伴插件「独立 WebUI」的默认端口（standalone_webui_port），
#    撞车时失败在插件那侧，很难查。详见 emotion_app/infra/config.py 的注释。
EMOTION_SERVER_PORT=6191
# 挂 TLS 反代后改 true（否则会话 cookie 不带 Secure）
EMOTION_SERVER_HTTPS_ONLY=false

# ---- 鉴权（必填，≥16 字符，否则拒绝启动）----
# 生成：.venv/bin/python -m emotion_app token
EMOTION_AUTH_ACCESS_TOKEN=''
EMOTION_AUTH_SESSION_TTL_HOURS=168

# ---- 存储 ----
EMOTION_STORAGE_BACKEND=sqlite
EMOTION_STORAGE_SQLITE_PATH=data/emotion.db

# ---- 聊天上游 ----
EMOTION_UPSTREAM_BASE_URL=https://api.syuan.org/v1
EMOTION_UPSTREAM_API_KEY=''
EMOTION_UPSTREAM_MODEL=gemini-3.1-flash-lite
EMOTION_UPSTREAM_TIMEOUT_SECONDS=60

# ---- 生图 ----
EMOTION_IMAGE_ENABLED=true
EMOTION_IMAGE_BASE_URL=https://api.syuan.org/v1
EMOTION_IMAGE_API_KEY=''
EMOTION_IMAGE_MODEL=nai-diffusion-5-full
EMOTION_IMAGE_SIZE=832x1216
EMOTION_IMAGE_OUTPUT_DIR=data/images
EMOTION_IMAGE_DISPATCH=function_call
EMOTION_IMAGE_EXTRA_PARAMS='{"steps":28,"scale":5.0}'

# 全局兜底参考图（**可选，一般不用填**）。
#
# ⚠️ 2026-09-25 起，参考图的**正常入口是在面板上上传**：
#    人设页 → 选中角色 → 「角色参考图」→ 选图片 → 上传（每人设一张）。
#    → 本变量只是**兜底**：当前人设**没上传**自己的参考图时才轮到它。
#    只在"我只有一个角色"时才建议用这里。
#
# selfie 时模型没指定参考图 → 自动带上它，同一个角色画出来才稳定。
# ⚠️ 只在 selfie 上生效；edit 的语义是"改用户给的那张图"，不会被它顶掉。
# ⚠️ 路径读不到会**响亮失败**（不会静默画一张不像的）。
# ⚠️ 实测该上游的精准参考只支持 NAI 4.5 系 —— 配了它，selfie 会自动切到
#    nai-diffusion-4-5-full 并打 WARNING（详见 docs/REF_IMAGE.md §7）。
EMOTION_IMAGE_PERSONA_REFERENCE=''

# ---- 日志 ----
EMOTION_LOGGING_LEVEL=INFO
EMOTION_LOGGING_JSON=false

# ---- 插件宿主（AstrBot 插件）----
# 🔴 **默认关闭**：插件会执行任意代码 + 读写自己的数据目录，属"高信任"能力。
#    不开的话，聊天/人设/生图等功能完全不受影响（连 host/ 都不会 import）。
EMOTION_PLUGINS_ENABLED=false
# 插件源码目录（**只读输入**；分号分隔多个）。
# 🔴 默认指向**本仓库自带的** `plugins/`（随代码走，换设备不用重新拉）。
# ⚠️ **要装新插件**：把插件目录放进 `plugins/`，重启服务即可 ——
#    `PluginLoader.discover()` 是**扫目录**，没有白名单，**不用改代码**
#    （判据：`tests/test_plugin_dir_extensibility.py`）。
# ⚠️ 想临时接一个正在跑的 AstrBot，写多个用分号隔开，如
#    `plugins;/opt/astrbot/data/plugins`；那种情况下**务必保持镜像开着**
#    （插件会回写自己的源码目录，见下）。
EMOTION_PLUGINS_PLUGIN_DIRS=plugins
# 插件**数据**目录（可写；我们自己的，不要指向 AstrBot 的 data/）
EMOTION_PLUGINS_DATA_DIR=data/plugins
# 🔴 源码镜像：先把源码复制到我们自己的可写副本，再从副本加载。
#    为什么必须开：插件会回写**自己的源码目录**（实测 comfyui_pro 把 workflow
#    列表写回 `_conf_schema.json`，那文件是两边共用的）→ 不镜像就会覆盖掉
#    对方的配置，且完全静默。详见 host/README.md §8②。
EMOTION_PLUGINS_MIRROR_SOURCES=true
EMOTION_PLUGINS_SOURCE_MIRROR_DIR=data/plugin_src
# 加载后调用插件的 initialize()（陪伴系插件靠它起后台任务）
EMOTION_PLUGINS_AUTO_INITIALIZE=true
# 🔴 单个插件 initialize() 的等待上限（秒）。实测：media_parser 会联网下载
#    26MB 字体（它自己超时 180s）→ 不设上限会把服务启动卡 181.6 秒。
#    正常插件实测 ≤0.01s，20s 足够宽松。
EMOTION_PLUGINS_INITIALIZE_TIMEOUT=20
# 挂载插件 Web API 路由（/api/plugins/extensions/...）
EMOTION_PLUGINS_MOUNT_WEB_APIS=true
